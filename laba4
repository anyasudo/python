# запуск программы
if __name__ == "__main__":
    user = User("Анна", 20, "anna@mail.ru")
    product = Product("Ноутбук", 50000, 10)
    
    logger = LoggerHandler()
    validator = ValidatorHandler()
    
    # подписываемся
    user.on_changing += validator
    user.on_changed += logger
    
    product.on_changing += validator
    product.on_changed += logger
    
    print("--- 1. Успешное изменение ---")
    user.age = 21 
    product.price = 55000 
    
    print("\n--- 2. Неудачное изменение (валидация не пройдена) ---")
    user.age = -5 
    product.price = 0 
    
    print(f"Текущий возраст остался: {user.age}")
    
    print("\n--- 3. Отписка обработчика ---")
    user.on_changed -= logger
    
    user.name = "Аня" 
    print(f"Имя изменилось на {user.name}, но логер об этом промолчал")
