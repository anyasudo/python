def is_valid(x):
    if x == 1:
        return True
    for p in (3, 5, 7):
        while x % p == 0:
            x //= p
    return x == 1


def main():
    try:
        x = int(input("Введите число x: "))
    except ValueError:
        print("Нужно ввести целое число")
        return

    result = []
    for i in range(1, x + 1):
        if is_valid(i):
            result.append(str(i))

    print(" ".join(result))


if __name__ == "__main__":
    main()
